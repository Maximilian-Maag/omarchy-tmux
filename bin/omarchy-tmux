#!/usr/bin/env python3
"""omarchy-tmux — theme the installed tmux from the applied Omarchy theme.

The applied theme is read *live* from
``$XDG_STATE_HOME/omarchy/current/theme/colors.toml`` (default
``~/.local/state/omarchy/current/theme/colors.toml``) on every run. No colour
palette is baked into this plugin, so every Omarchy theme — including one the
user wrote themselves — produces a correctly themed tmux.

The generated file is written to a dedicated path (``~/.config/tmux/omarchy-theme.conf``
by default, override with ``config/tmux.json``) which the user's own
``~/.config/tmux/tmux.conf`` sources. Nothing under ``~/.config/tmux`` other than
that one file is ever touched.

Subcommands:
  theme      generate the tmux theme conf from the applied theme
  bindings   install the Hyprland keybinding module
  status     report the applied theme, generated file and tmux state
"""

from __future__ import annotations

import argparse
import json
import os
import pathlib
import re
import subprocess
import sys

PLUGIN_ID = "Maximilian-Maag.tmux"

HEADER = (
    "# Generated by omarchy-tmux from the applied Omarchy theme.\n"
    "# Do not edit by hand — re-run `omarchy-tmux theme` after a theme change.\n"
    "# Source this from your own tmux config:\n"
    "#   source-file ~/.config/tmux/omarchy-theme.conf\n"
)

DEFAULT_CONFIG = {
    "conf_path": "tmux/omarchy-theme.conf",
    "keybinding": "SUPER + SHIFT + ALT + T",
}

# tmux style keywords that are bare flags rather than key=value pairs.
FLAGS = ("bold", "italics", "underscore")


def state_home() -> pathlib.Path:
    """Omarchy's state root — where the applied theme lives."""
    return pathlib.Path(os.environ.get("XDG_STATE_HOME") or (pathlib.Path.home() / ".local/state"))


def config_home() -> pathlib.Path:
    """The XDG config root."""
    return pathlib.Path(os.environ.get("XDG_CONFIG_HOME") or (pathlib.Path.home() / ".config"))


def plugin_dir() -> pathlib.Path:
    """This plugin's checkout.

    ``bin/omarchy-tmux`` is installed as a symlink into the repo, and
    ``Path.resolve`` follows it, so this works for both the dev checkout and an
    installed plugin.
    """
    return pathlib.Path(__file__).resolve().parent.parent


def theme_colors_path() -> pathlib.Path:
    """The applied theme's colours.toml (a copy; the name is not in the path)."""
    return state_home() / "omarchy" / "current" / "theme" / "colors.toml"


def theme_search_dirs() -> list[pathlib.Path]:
    """Every installed theme directory, system-wide first then per-user."""
    dirs: list[pathlib.Path] = []
    for root in ("/usr/share/omarchy/themes", str(config_home() / "omarchy" / "themes")):
        base = pathlib.Path(root)
        if base.is_dir():
            dirs.extend(sorted(p for p in base.iterdir() if p.is_dir()))
    return dirs


def load_config(path: pathlib.Path | None = None) -> dict:
    """Read config/tmux.json, falling back to the built-in defaults."""
    path = pathlib.Path(path) if path is not None else (plugin_dir() / "config" / "tmux.json")
    data = dict(DEFAULT_CONFIG)
    if path.is_file():
        try:
            data.update(json.loads(path.read_text()))
        except ValueError:
            pass
    return data


def theme_conf_path(cfg: dict | None = None) -> pathlib.Path:
    """Where the generated tmux theme conf is written.

    A ``conf_path`` that is absolute or starts with ``~`` is used as-is; a
    relative one is resolved under the XDG config root, so the default respects
    ``$XDG_CONFIG_HOME``.
    """
    cfg = cfg if cfg is not None else load_config()
    raw = str(cfg.get("conf_path") or DEFAULT_CONFIG["conf_path"])
    if raw.startswith("~") or raw.startswith("/"):
        return pathlib.Path(os.path.expanduser(raw))
    return config_home() / raw


def parse_colors(text: str) -> dict:
    """Parse an Omarchy colors.toml into a plain ``{key: value}`` dict.

    Blank lines and ``#`` comments are skipped; surrounding quotes are stripped
    from values. Hex colour values survive because only a line whose *first*
    non-space character is ``#`` counts as a comment.
    """
    colors: dict[str, str] = {}
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            continue
        key, _, value = line.partition("=")
        key = key.strip()
        value = value.strip().strip('"').strip("'")
        if not key:
            continue
        colors[key] = value
    return colors


def normalize_name(name: str) -> str:
    """Omarchy theme names are Title Case; directories are lower-dashed."""
    return name.strip().lower().replace(" ", "-")


def resolve_theme_name(colors: dict, search_dirs: list[pathlib.Path]) -> str:
    """Recover the applied theme's name by matching colours against the themes.

    The applied theme is a *copy*, so its directory is always literally
    ``theme`` and the name is nowhere in the path. Match the colour set against
    each installed theme instead.
    """
    for directory in search_dirs:
        candidate = directory / "colors.toml"
        if not candidate.is_file():
            continue
        if parse_colors(candidate.read_text()) == colors:
            return directory.name
    return ""


def tmux_colour(value: str) -> str:
    """Normalise an Omarchy colour value to something tmux accepts.

    ``#rrggbb`` passes through; a Hyprland ``rgba(rrggbbaa)`` gradient stop is
    reduced to its ``#rrggbb``. Anything else is an error — silently emitting a
    bogus colour would leave tmux rendering a fallback.
    """
    value = value.strip()
    if value.startswith("#") and len(value) == 7:
        return value
    match = re.fullmatch(r"rgba\(([0-9a-fA-F]{6})([0-9a-fA-F]{2})\)", value)
    if match:
        return "#" + match.group(1)
    raise ValueError("unsupported colour: %s" % value)


def style(**parts) -> str:
    """Compose a tmux style string from keyword parts, skipping empties."""
    pieces: list[str] = []
    for key in ("fg", "bg"):
        value = parts.get(key)
        if value:
            pieces.append("%s=%s" % (key, value))
    for key in FLAGS:
        if parts.get(key):
            pieces.append(key)
    return ",".join(pieces)


def q(value: str) -> str:
    """Wrap a tmux style value in double quotes."""
    return '"' + value + '"'


def build_conf(colors: dict) -> str:
    """Render the full tmux theme conf from an Omarchy colour map."""
    bg = tmux_colour(colors["background"])
    fg = tmux_colour(colors["foreground"])
    accent = tmux_colour(colors["accent"])
    selection = tmux_colour(
        colors.get("selection") or colors.get("lighter_background") or colors["background"]
    )
    muted = tmux_colour(
        colors.get("muted") or colors.get("dark_foreground") or colors["foreground"]
    )
    bold = colors.get("mode", "dark") == "dark"

    status = style(bg=bg, fg=fg)
    active = style(fg=accent, bg=selection, bold=bold)
    inactive = style(fg=muted, bg=bg)
    message = style(bg=selection, fg=accent)

    lines = [
        HEADER.rstrip("\n"),
        "",
        "# status bar",
        "set -g status-style " + q(status),
        "set -g status-left " + q("#[fg=%s,bg=%s,bold] #S #[bg=%s,fg=%s]" % (bg, accent, bg, fg)),
        "set -g status-right " + q(
            "#[fg=%s]#{?client_prefix,PREFIX ,}#{?window_zoomed_flag,ZOOM ,}#h" % accent
        ),
        "",
        "# windows — inactive vs active",
        "set -g window-status-format " + q("#[%s] #I:#W " % inactive),
        "set -g window-status-current-format " + q("#[%s] #I:#W " % active),
        "",
        "# panes",
        "set -g pane-border-style " + q(style(fg=muted)),
        "set -g pane-active-border-style " + q(style(fg=accent)),
        "",
        "# messages and selection",
        "set -g message-style " + q(message),
        "set -g message-command-style " + q(message),
        "set -g mode-style " + q(style(bg=selection, fg=accent)),
        "setw -g clock-mode-colour " + accent,
    ]
    return "\n".join(lines) + "\n"


def tmux_version() -> str:
    """The installed tmux version, or a sentinel when it is missing."""
    try:
        out = subprocess.run(["tmux", "-V"], capture_output=True, text=True)
    except (OSError, subprocess.SubprocessError):
        return "not installed"
    return out.stdout.strip() or "unknown"


def cmd_theme(args) -> int:
    cfg = load_config(args.config)
    colors_path = theme_colors_path()
    if not colors_path.is_file():
        print("omarchy-tmux: no applied theme at %s" % colors_path, file=sys.stderr)
        return 1
    colors = parse_colors(colors_path.read_text())
    conf = build_conf(colors)
    if args.stdout:
        sys.stdout.write(conf)
        return 0
    out = theme_conf_path(cfg)
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(conf)
    print("omarchy-tmux: wrote %s" % out)
    name = resolve_theme_name(colors, theme_search_dirs())
    if name:
        print("omarchy-tmux: applied theme: %s" % name)
    return 0


def cmd_bindings(args) -> int:
    src = plugin_dir() / "bin" / "bindings.lua"
    if not src.is_file():
        print("omarchy-tmux: bindings.lua not found at %s" % src, file=sys.stderr)
        return 1
    hypr = config_home() / "hypr"
    hypr.mkdir(parents=True, exist_ok=True)
    dest = hypr / "tmux-bindings.lua"
    dest.write_text(src.read_text())
    require = 'require("hypr.tmux-bindings")'
    main = hypr / "hyprland.lua"
    if main.is_file():
        text = main.read_text()
        if require not in text:
            with main.open("a") as fh:
                fh.write("\n-- omarchy-tmux keybindings\n" + require + "\n")
            print("omarchy-tmux: wired %s into %s" % (require, main))
        else:
            print("omarchy-tmux: keybindings already wired")
    else:
        print("omarchy-tmux: %s not found — add %s" % (main, require))
    print("omarchy-tmux: wrote %s" % dest)
    return 0


def cmd_status(args) -> int:
    cfg = load_config(args.config)
    colors_path = theme_colors_path()
    name = ""
    if colors_path.is_file():
        colors = parse_colors(colors_path.read_text())
        name = resolve_theme_name(colors, theme_search_dirs())
    conf = theme_conf_path(cfg)
    print("omarchy-tmux %s" % PLUGIN_ID)
    print("applied theme : %s" % (name or "(unknown)"))
    print("colors        : %s%s" % (colors_path, "" if colors_path.is_file() else " (missing)"))
    print("theme conf    : %s%s" % (conf, "" if conf.is_file() else " (not generated)"))
    print("keybinding    : %s" % cfg.get("keybinding"))
    print("tmux          : %s" % tmux_version())
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="omarchy-tmux", description=__doc__.splitlines()[0])
    parser.add_argument("--config", default=None,
                        help="path to config/tmux.json (default: the plugin's own)")
    sub = parser.add_subparsers(dest="command", required=True)

    theme = sub.add_parser("theme", help="generate the tmux theme conf from the applied theme")
    theme.add_argument("--stdout", action="store_true", help="print the conf instead of writing it")
    theme.set_defaults(func=cmd_theme)

    bindings = sub.add_parser("bindings", help="install the Hyprland keybinding module")
    bindings.set_defaults(func=cmd_bindings)

    status = sub.add_parser("status", help="report the applied theme and generated file")
    status.set_defaults(func=cmd_status)
    return parser


def main(argv=None) -> int:
    args = build_parser().parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
