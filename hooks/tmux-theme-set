#!/bin/bash
# omarchy hook: theme-set — regenerate the tmux theme from the applied theme.
#
# `omarchy hook install` copies this file into the hooks directory under its
# BASENAME, so resolving the plugin relative to the script's own directory lands
# in the hooks dir, NOT in this plugin. It therefore self-locates: the plugin is
# found via $OMARCHY_TMUX_DIR, the Omarchy plugins dir, or the dev checkout.
set -euo pipefail

THEME=$(echo "${1:-}" | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
[[ -z "$THEME" ]] && exit

find_plugin() {
  local base
  for base in "${OMARCHY_TMUX_DIR:-}" \
              "${XDG_DATA_HOME:-$HOME/.local/share}/omarchy/plugins/Maximilian-Maag.tmux" \
              "$HOME/.local/share/omarchy/plugins/Maximilian-Maag.tmux" \
              "$HOME/.config/omarchy/plugins/Maximilian-Maag.tmux" \
              "$HOME/Work/omarchy-tmux"; do
    if [[ -n "$base" && -x "$base/bin/omarchy-tmux" ]]; then
      printf '%s\n' "$base"
      return
    fi
  done
  false
}

PLUGIN=""
if found="$(find_plugin)"; then
  PLUGIN="$found"
fi
if [[ -z "$PLUGIN" ]]; then
  exit
fi

CLI="$PLUGIN/bin/omarchy-tmux"
if ! "$CLI" theme &>/dev/null; then
  : # theme generation failed; nothing more to do
fi

# Reload the running tmux server, if there is one. Never start one.
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/tmux/omarchy-theme.conf"
if [[ -f "$CONF" ]] && tmux list-sessions &>/dev/null; then
  tmux source-file "$CONF" &>/dev/null || true
fi
